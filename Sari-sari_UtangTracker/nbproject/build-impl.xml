<?xml version="1.0" encoding="UTF-8"?>
<project name="UtangTracker-impl" basedir=".." default="jar">
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="build.classes.dir" value="${build.dir}/classes"/>
    <property name="dist.dir" value="dist"/>
    <property name="dist.jar" value="${dist.dir}/UtangTracker2.jar"/>
    <property name="app.jar" value="UtangTracker2.jar"/>
    <property name="mysql.jar" value="lib/mysql-connector-j-26.7.0.jar"/>
    <property name="main.class" value="utangtracker.UtangTracker"/>
    <property name="javac.source" value="1.8"/>
    <property name="javac.target" value="1.8"/>

    <target name="init">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${dist.dir}/lib"/>
    </target>

    <target name="-pre-init"/>
    <target name="-init-private"/>
    <target name="-init-user"/>
    <target name="-init-project"/>
    <target name="-do-init"/>
    <target name="-post-init"/>
    <target name="deps-jar" depends="init"/>
    <target name="-pre-compile"/>
    <target name="-post-compile"/>

    <target name="-do-compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}"
               source="${javac.source}" target="${javac.target}"
               encoding="UTF-8" includeantruntime="false"
               classpath="${mysql.jar}" debug="true"/>
    </target>
    <target name="compile" depends="init,-do-compile"/>
    <target name="compile-single" depends="compile"/>

    <target name="-pre-jar"/>
    <target name="-post-jar"/>
    <target name="-do-jar" depends="compile">
        <copy file="${mysql.jar}" tofile="${dist.dir}/lib/mysql-connector-j-26.7.0.jar" overwrite="true"/>
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Class-Path" value="lib/mysql-connector-j-26.7.0.jar"/>
            </manifest>
        </jar>
        <copy file="${dist.jar}" tofile="${app.jar}" overwrite="true"/>
    </target>
    <target name="jar" depends="compile,-do-jar"/>
    <target name="default" depends="jar"/>

    <target name="run" depends="jar">
        <java jar="${app.jar}" fork="true" dir="${basedir}">
            <jvmarg value="-Dfile.encoding=UTF-8"/>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
        </java>
    </target>
    <target name="run-single" depends="run"/>
    <target name="debug" depends="run"/>
    <target name="debug-single" depends="debug"/>
    <target name="profile" depends="run"/>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
        <delete file="${app.jar}"/>
    </target>

    <target name="javadoc" depends="init">
        <mkdir dir="${dist.dir}/javadoc"/>
        <javadoc sourcepath="${src.dir}" destdir="${dist.dir}/javadoc" classpath="${mysql.jar}"/>
    </target>
    <target name="test" depends="compile"/>
    <target name="test-single" depends="test"/>
    <target name="compile-test" depends="compile"/>
</project>
